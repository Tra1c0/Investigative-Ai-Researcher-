{
  "permissions": {
    "allow": [
      "Bash(python3 tools/karte.py status *)",
      "Bash(python3 tools/karte.py pruefe *)",
      "Bash(python3 tools/karte.py stempel *)",
      "Bash(python3 tools/karte.py neu *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PROJECT_DIR}/tools/karte.py", "hook"],
            "timeout": 20
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "scout|worker|reviewer|thinker",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PROJECT_DIR}/tools/karte.py", "hook"],
            "timeout": 20
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "worker",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PROJECT_DIR}/tools/karte.py", "hook"],
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PROJECT_DIR}/tools/karte.py", "hook"],
            "timeout": 20
          }
        ]
      }
    ]
  }
}
